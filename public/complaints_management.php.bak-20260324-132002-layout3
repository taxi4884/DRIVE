function v(array $row, array $keys): ?string {
    foreach ($keys as $k) {
        if (array_key_exists($k, $row) && $row[$k] !== null && $row[$k] !== '') {
            return trim((string)$row[$k]);
        }
    }
    return null;
}

$gatewayLastDebug = '';

function gatewayCall(array $payload): array {
    $ch = curl_init('https://4884gateway.de/fms');
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST => true,
        CURLOPT_HTTPHEADER => ['Content-Type: application/json', 'Accept: application/json'],
        CURLOPT_POSTFIELDS => json_encode($payload, JSON_UNESCAPED_UNICODE),
        CURLOPT_TIMEOUT => 15,
    ]);
    $raw = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $curlErr = curl_error($ch);
    curl_close($ch);

    $decoded = null;
    if (is_string($raw) && $raw !== '') {
        $tmp = json_decode($raw, true);
        if (is_array($tmp)) {
            $decoded = $tmp;
        }
    }

    return [
        'ok' => ($curlErr === '' && $code >= 200 && $code < 300),
        'http_code' => $code,
        'curl_error' => $curlErr,
        'raw' => is_string($raw) ? $raw : '',
        'decoded' => $decoded,
    ];
}

function findDriverByDisplayRecursive($node, string $display): ?array {
    $norm = ltrim($display, '0');
    $norm = $norm === '' ? '0' : $norm;

    if (is_array($node)) {
        $map = [];
        foreach ($node as $k => $val) {
            $map[strtolower((string)$k)] = $val;
        }
        $displayKeys = ['displaynummer', 'display_number', 'fahrer_displaynummer', 'fahrerdisplaynummer'];
        foreach ($displayKeys as $dk) {
            if (!isset($map[$dk])) continue;
            $candidate = ltrim((string)$map[$dk], '0');
            $candidate = $candidate === '' ? '0' : $candidate;
            if ($candidate === $norm) {
                return $node;
            }
        }
        foreach ($node as $child) {
            $found = findDriverByDisplayRecursive($child, $display);
            if ($found) return $found;
        }
    }
    return null;
}

function loadDriverFromGateway(string $display): ?array {
    global $gatewayLastDebug;

    $attempts = [
        ['GETFAHRER' => ['FAHRER_NR' => (int)$display]],
        ['GETFAHRER' => ['nummer' => (int)$display]],
        ['getfahrer' => ['displaynummer' => $display]],
        ['GETFAHRERLISTE' => new stdClass()],
    ];

    foreach ($attempts as $payload) {
        $result = gatewayCall($payload);
        $response = $result['decoded'];
        $gatewayLastDebug = json_encode([
            'payload' => $payload,
            'http_code' => $result['http_code'],
            'curl_error' => $result['curl_error'],
            'raw_head' => mb_substr((string)$result['raw'], 0, 400),
        ], JSON_UNESCAPED_UNICODE);

        if (!is_array($response)) {
            continue;
        }

        $candidate = findDriverByDisplayRecursive($response, $display);
        if (!$candidate && isset($response['displaynummer'])) {
            $candidate = $response;
        }
        if (!$candidate && isset($response['fahrerNr']) && (string)$response['fahrerNr'] == (string)(int)$display) {
            $candidate = $response;
        }
        if (!$candidate) {
            continue;
        }

        return [
            'display_number' => (string)(v($candidate, ['displaynummer','display_number']) ?? $display),
            'driver_number' => v($candidate, ['fahrerNr','fahrernummer','fahrer_nr','nummer','fahrernr']),
            'first_name' => v($candidate, ['vorname','first_name']),
            'last_name' => v($candidate, ['nachname','last_name']),
            'street' => v($candidate, ['strasseName','strasse','street']),
            'house_no' => v($candidate, ['hausnummerEcke','hausnummer','house_no']),
            'postal_code' => v($candidate, ['plz','postal_code']),
            'city' => v($candidate, ['ortName','ort','city']),
            'email' => v($candidate, ['email','e_mail']),
            'mobile' => v($candidate, ['mobiltelefonnummer','handynummer','mobilnummer','mobile']),
            'raw_payload' => json_encode($response, JSON_UNESCAPED_UNICODE),
        ];
    }
    return null;
}

function renderComplaintLetter(array $row, string $template, string $extra): string {
    if ($template === '') {
        $template = "{{fahrer_name}}\n{{fahrer_strasse}}\n{{fahrer_ort}}\n\nBeschwerde zu Auftrag {{auftragsnummer}}\n\nSehr geehrte Damen und Herren,\n\nhiermit informieren wir Sie über das Fehlverhalten Ihres Mitarbeiters.\n\nSachverhalt:\n{{sachverhalt}}\n\nZusatz:\n{{zusaetzlicher_text}}\n\nMit freundlichen Grüßen\n\nVerwaltung\n4884 - Ihr Funktaxi GmbH";
    }

    $fahrerName = trim((string)($row['first_name'] ?? '') . ' ' . (string)($row['last_name'] ?? ''));
    $vars = [
        '{{datum}}' => date('d.m.Y'),
        '{{auftragsnummer}}' => (string)($row['order_number'] ?? ''),
        '{{sachverhalt}}' => (string)($row['subject'] ?? ''),
        '{{zusaetzlicher_text}}' => $extra,
        '{{displaynummer}}' => (string)($row['display_number'] ?? ''),
        '{{fahrernummer}}' => (string)($row['driver_number'] ?? ''),
        '{{fahrer_vorname}}' => (string)($row['first_name'] ?? ''),
        '{{fahrer_nachname}}' => (string)($row['last_name'] ?? ''),
        '{{fahrer_name}}' => $fahrerName,
        '{{fahrer_strasse}}' => trim((string)($row['street'] ?? '') . ' ' . (string)($row['house_no'] ?? '')),
        '{{fahrer_ort}}' => trim((string)($row['postal_code'] ?? '') . ' ' . (string)($row['city'] ?? '')),
        '{{firma}}' => (string)($row['company_name'] ?? 'Ihr Unternehmen'),
        '{{firma_strasse}}' => trim((string)($row['e_street'] ?? '') . ' ' . (string)($row['e_house_no'] ?? '')),
        '{{firma_ort}}' => trim((string)($row['e_postal_code'] ?? '') . ' ' . (string)($row['e_city'] ?? '')),
    ];
    return strtr($template, $vars);
}

function removeInternalSentenceFromPreview(string $text): string {
    $needle = 'hiermit informieren wir Sie über das Fehlverhalten Ihres Mitarbeiters.';
    $text = str_replace(["\r\n", "\r"], "\n", $text);
    $lines = explode("\n", $text);
    $filtered = [];
    foreach ($lines as $line) {
        if (mb_strtolower(trim($line)) === mb_strtolower($needle)) {
            continue;
        }
        $filtered[] = $line;
    }
    return trim(preg_replace("/\n{3,}/", "\n\n", implode("\n", $filtered)) ?? '');
}

