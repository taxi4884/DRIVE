<script>
(function () {
  const editor = document.getElementById('templateEditor');
  document.querySelectorAll('.js-template-var').forEach((el) => {
    el.addEventListener('dblclick', () => {
      if (!editor) return;
      const token = el.dataset.token || '';
      const start = editor.selectionStart ?? editor.value.length;
      const end = editor.selectionEnd ?? editor.value.length;
      editor.value = editor.value.slice(0, start) + token + editor.value.slice(end);
      editor.focus();
      const pos = start + token.length;
      editor.setSelectionRange(pos, pos);
    });
  });
})();

function openPreviewPdf() {
  const form = document.getElementById('letterForm');
  const action = document.getElementById('letterAction');
  const oldAction = action.value;
  const oldTarget = form.target;
  action.value = 'preview_letter_pdf';
  form.target = '_blank';
  form.submit();
  action.value = oldAction;
  form.target = oldTarget;
}
</script>
