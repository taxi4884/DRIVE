            $letterRenderedRaw = $previewRendered;
            $letterOutput = nl2br(htmlspecialchars($previewRendered, ENT_QUOTES, 'UTF-8'));
            $lastComplaintId = $complaintId;
            $lastTemplate = $template;
            $lastExtra = $extra;

            if ($action === 'build_letter') {
                audit($pdo, $complaintId, 'letter_preview', 'Briefvorschau erzeugt');
                $ok = 'Briefvorschau erzeugt.';
            }

            if ($action === 'preview_letter_pdf') {
                $pdf = new FPDF('P', 'mm', 'A4');
                $pdf->AddPage();
                addComplaintLetterBackground($pdf);
                $pdf->SetFont('Arial', '', 11);
                writeComplaintLetterBody($pdf, $previewRendered, date('d.m.Y'), 20, 58);
                header('Content-Type: application/pdf');
                header('Content-Disposition: inline; filename="brief_vorschau_' . $complaintId . '.pdf"');
                $pdf->Output('I', 'brief_vorschau_' . $complaintId . '.pdf');
                exit;
            }

            if ($action === 'send_letter_email') {
                if (empty($row['due_date'])) {
                    $dueDateToSet = null;
                    if ((string)($row['action_type'] ?? 'strafe') === 'strafe') {
                        $dueDateToSet = date('Y-m-d', strtotime('+7 days'));
                    } elseif ((string)($row['action_type'] ?? '') === 'kuendigung') {
                        $dueDateToSet = date('Y-m-d');
                    }
                    if ($dueDateToSet !== null) {
                        $upDue = $pdo->prepare('UPDATE complaints SET due_date = :due_date WHERE id = :id');
                        $upDue->execute([':due_date' => $dueDateToSet, ':id' => (int)$row['id']]);
                        $row['due_date'] = $dueDateToSet;
                    }
                }

                $rendered = renderComplaintLetter($row, $template, $extra, 'entrepreneur');

                $recipient = trim((string)($row['e_email'] ?? ''));
                if ($recipient === '' && !empty($row['e_email2'])) $recipient = trim((string)$row['e_email2']);
                if ($recipient === '' || !filter_var($recipient, FILTER_VALIDATE_EMAIL)) {
                    throw new RuntimeException('Keine gültige Unternehmer-E-Mail hinterlegt.');
                }

                $outDir = __DIR__ . '/output';
                if (!is_dir($outDir)) @mkdir($outDir, 0775, true);
                $pdfFile = $outDir . '/beschwerde_' . $complaintId . '_' . date('Ymd_His') . '.pdf';

                $pdf = new FPDF('P', 'mm', 'A4');
                $pdf->AddPage();
                addComplaintLetterBackground($pdf);
                $pdf->SetFont('Arial', '', 11);
                writeComplaintLetterBody($pdf, $rendered, date('d.m.Y'), 20, 58);
