                $mail->send();

                $upStatus = $pdo->prepare("UPDATE complaints SET status='in_pruefung' WHERE id=:id");
                $upStatus->execute([':id' => $complaintId]);

                audit($pdo, $complaintId, 'letter_email', 'Beschwerdeschreiben per E-Mail versendet an ' . $recipient . '; Status auf in_pruefung gesetzt');
                $ok = 'E-Mail mit Schreiben wurde an ' . $recipient . ' versendet. Status: warten auf Zahlung.';
            }

        }

    } catch (Throwable $e) {
        $err = 'Fehler: ' . $e->getMessage();
