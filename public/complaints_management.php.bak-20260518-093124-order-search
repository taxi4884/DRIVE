main.container.py-4 div.dataTables_scrollBody,
main.container.py-4 .dataTables_wrapper .dataTables_scrollBody {
  height: auto !important;
  max-height: none !important;
  min-height: 0 !important;
  overflow-y: visible !important;
}
main.container.py-4 .dataTables_wrapper .dataTables_scroll {
  margin-bottom: .5rem;
}
main.container.py-4 .dataTables_wrapper {
  margin-bottom: 0 !important;
}
main.container.py-4 .table thead th { position: sticky; top: 0; background: #fff; z-index: 2; border-bottom-width: 2px; }
main.container.py-4 .table td, main.container.py-4 .table th { vertical-align: middle; padding-top: .65rem; padding-bottom: .65rem; }
main.container.py-4 .js-complaint-row:hover { background: #f8fbff; }
main.container.py-4 .badge { font-weight: 600; letter-spacing: .1px; }
main.container.py-4 .alert { border-radius: 10px; }
main.container.py-4 .modal-content { border: 0; border-radius: 14px; box-shadow: 0 16px 40px rgba(0,0,0,.18); }
main.container.py-4 .modal-header { border-bottom: 1px solid #eef1f4; background: #fafcff; }
main.container.py-4 .modal-footer { border-top: 1px solid #eef1f4; background: #fcfdff; }
main.container.py-4 .form-label { font-weight: 600; margin-bottom: .3rem; }
main.container.py-4 .form-control, main.container.py-4 .form-select { border-radius: 10px; }
main.container.py-4 .btn { border-radius: 10px; }
main.container.py-4 .js-subject-template { border-radius: 999px; }
main.container.py-4 .quick-kpis { display:flex; gap:.5rem; flex-wrap:wrap; margin:.3rem 0 .8rem; }
main.container.py-4 .quick-kpis .chip { padding:.35rem .65rem; border-radius:999px; font-size:.82rem; font-weight:600; border:1px solid #e9ecef; background:#fff; }
main.container.py-4 .quick-kpis .chip.warn { background:#fff8e1; border-color:#ffe08a; }
main.container.py-4 .quick-kpis .chip.ok { background:#eafaf0; border-color:#b9ebc9; }
main.container.py-4 .quick-kpis .chip.info { background:#eaf3ff; border-color:#bfd8ff; }
</style>
<script>
(function () {
  const actionType = document.getElementById('actionTypeSelect');
  const penaltyWrap = document.getElementById('penaltyAmountWrap');
  const syncPenaltyVisibility = () => {
    if (!actionType || !penaltyWrap) return;
    penaltyWrap.style.display = actionType.value === 'strafe' ? '' : 'none';
  };
  if (actionType) {
    actionType.addEventListener('change', syncPenaltyVisibility);
    syncPenaltyVisibility();
  }

  const driverMeta = <?= json_encode($driverComplaintMeta, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
  const orderLookup = <?= json_encode($orderLookup, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;
  const createOrderNumber = document.getElementById('create_order_number');
  const createOrderDuplicateAlert = document.getElementById('createOrderDuplicateAlert');
  const createDriverSearch = document.getElementById('create_driver_search');
  const createDriverSelect = document.getElementById('create_driver_id');
  const createEntrepreneurSelect = document.getElementById('create_entrepreneur_id');
  const repeatAlert = document.getElementById('driverRepeatAlert');
  const recentWrap = document.getElementById('driverRecentComplaints');

  const editOrderNumber = document.getElementById('edit_order_number');
  const editOrderDuplicateAlert = document.getElementById('editOrderDuplicateAlert');
  const editDriverSearch = document.getElementById('edit_driver_search');
  const editDriverSelect = document.getElementById('edit_driver_id');
  const editEntrepreneurSelect = document.getElementById('edit_entrepreneur_id');
  const editRepeatAlert = document.getElementById('editDriverRepeatAlert');
  const editRecentWrap = document.getElementById('editDriverRecentComplaints');

  const checkOrderDuplicate = (inputEl, alertEl, currentComplaintId = null) => {
    if (!inputEl || !alertEl) return;
    const key = (inputEl.value || '').trim();
    if (!key) {
      alertEl.className = 'small mt-1 text-muted';
      alertEl.textContent = '';
      return;
    }
    const foundId = orderLookup[key];
    if (foundId && String(foundId) !== String(currentComplaintId || '')) {
      alertEl.className = 'small mt-1 text-danger';
      alertEl.textContent = `⚠️ Auftrag bereits vorhanden als Beschwerde #${foundId}`;
    } else {
      alertEl.className = 'small mt-1 text-success';
      alertEl.textContent = '✓ Keine doppelte Auftragsnummer gefunden';
    }
  };

  const renderTimeline = (meta) => {
    const recent = Array.isArray(meta?.recent) ? meta.recent : [];
    if (!recent.length) return '';
    const rows = recent.map((r) => {
      const dt = (r.created_at || '').slice(0, 10);
      const status = r.status || '-';
      const action = r.action_type || '-';
      const company = r.company_name || '-';
      return `<div class="border-start ps-2 mb-1">${dt} · Status: ${status} · Maßnahme: ${action} · Unternehmer: ${company}</div>`;
    }).join('');
    return `<div class="fw-semibold mb-1">Chronik (letzte Fälle):</div>${rows}`;
  };

  const filterDriverOptions = (searchInput, selectEl) => {
    if (!searchInput || !selectEl) return;
    const q = (searchInput.value || '').toLowerCase().trim();
    Array.from(selectEl.options).forEach((opt, idx) => {
      if (idx === 0) {
        opt.hidden = false;
        return;
      }
      const txt = (opt.textContent || '').toLowerCase();
      opt.hidden = q !== '' && !txt.includes(q);
    });
  };

  const applyDriverComplaintMetaFor = (driverSelect, entrepreneurSelect, alertEl, recentEl) => {
    if (!driverSelect || !alertEl || !recentEl) return;
    const driverId = driverSelect.value || '';
    const meta = driverMeta[driverId];
    if (!driverId || !meta) {
      alertEl.className = 'alert alert-secondary py-2 mb-2';
      alertEl.textContent = 'Keine frühere Beschwerde gefunden.';
      recentEl.innerHTML = '';
      return;
    }

    const count = Number(meta.count || 0);
    if (count >= 2) {
      alertEl.className = 'alert alert-danger py-2 mb-2';
      alertEl.textContent = `⚠️ Wiederholte Beschwerden: ${count}`;
    } else if (count === 1) {
      alertEl.className = 'alert alert-warning py-2 mb-2';
      alertEl.textContent = 'Hinweis: 1 frühere Beschwerde';
    } else {
      alertEl.className = 'alert alert-success py-2 mb-2';
      alertEl.textContent = 'Keine frühere Beschwerde gefunden.';
    }

    if (entrepreneurSelect && (!entrepreneurSelect.value || entrepreneurSelect.value === '') && meta.latest_entrepreneur_id) {
      entrepreneurSelect.value = String(meta.latest_entrepreneur_id);
    }

    const recent = Array.isArray(meta.recent) ? meta.recent : [];
    if (!recent.length) {
      recentEl.innerHTML = '';
      return;
    }

    recentEl.innerHTML = renderTimeline(meta);
  };

  if (createDriverSearch && createDriverSelect) {
    createDriverSearch.addEventListener('input', () => filterDriverOptions(createDriverSearch, createDriverSelect));
  }
  if (editDriverSearch && editDriverSelect) {
    editDriverSearch.addEventListener('input', () => filterDriverOptions(editDriverSearch, editDriverSelect));
  }
  if (createOrderNumber && createOrderDuplicateAlert) {
    createOrderNumber.addEventListener('input', () => checkOrderDuplicate(createOrderNumber, createOrderDuplicateAlert));
  }
  if (editOrderNumber && editOrderDuplicateAlert) {
    editOrderNumber.addEventListener('input', () => {
      const currentId = document.getElementById('edit_complaint_id')?.value || null;
      checkOrderDuplicate(editOrderNumber, editOrderDuplicateAlert, currentId);
    });
  }

  document.querySelectorAll('.js-subject-template').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.target;
      const txt = btn.dataset.text || '';
      const ta = document.getElementById(target === 'edit' ? 'edit_subject' : 'create_subject');
      if (!ta) return;
      if (ta.value.trim() === '') ta.value = txt;
      else ta.value = `${ta.value.trim()}\n${txt}`;
      ta.focus();
    });
  });

  if (createDriverSelect) {
    createDriverSelect.addEventListener('change', () => applyDriverComplaintMetaFor(createDriverSelect, createEntrepreneurSelect, repeatAlert, recentWrap));
    applyDriverComplaintMetaFor(createDriverSelect, createEntrepreneurSelect, repeatAlert, recentWrap);
  }
  if (editDriverSelect) {
    editDriverSelect.addEventListener('change', () => applyDriverComplaintMetaFor(editDriverSelect, editEntrepreneurSelect, editRepeatAlert, editRecentWrap));
  }

  const editActionType = document.getElementById('edit_action_type');
  const editPenaltyWrap = document.getElementById('edit_penalty_wrap');
  const syncEditPenaltyVisibility = () => {
    if (!editActionType || !editPenaltyWrap) return;
    editPenaltyWrap.style.display = editActionType.value === 'strafe' ? '' : 'none';
  };
  if (editActionType) {
    editActionType.addEventListener('change', syncEditPenaltyVisibility);
  }

  const editModalEl = document.getElementById('modalEditComplaint');
  const editModal = (editModalEl && window.bootstrap) ? new bootstrap.Modal(editModalEl) : null;
  document.querySelectorAll('.js-complaint-row').forEach((row) => {
    row.addEventListener('dblclick', () => {
      if (!editModal) return;
      const setVal = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.value = val ?? '';
      };
      setVal('edit_complaint_id', row.dataset.id || '');
      setVal('edit_order_number', row.dataset.orderNumber || '');
      setVal('edit_driver_id', row.dataset.driverId || '');
      setVal('edit_entrepreneur_id', row.dataset.entrepreneurId || '');
      setVal('edit_action_type', row.dataset.actionType || 'strafe');
      setVal('edit_penalty_amount', row.dataset.penaltyAmount || '50');
      setVal('edit_due_date', row.dataset.dueDate || '');
      setVal('edit_status', row.dataset.status || 'neu');
      setVal('edit_subject', row.dataset.subject || '');
      if (editDriverSearch) editDriverSearch.value = '';
      if (editDriverSearch && editDriverSelect) filterDriverOptions(editDriverSearch, editDriverSelect);
      applyDriverComplaintMetaFor(editDriverSelect, editEntrepreneurSelect, editRepeatAlert, editRecentWrap);
      checkOrderDuplicate(editOrderNumber, editOrderDuplicateAlert, row.dataset.id || null);
      syncEditPenaltyVisibility();
      editModal.show();
    });
  });
})();

function openPreviewPdf() {
  const form = document.getElementById('letterForm');
  const action = document.getElementById('letterAction');
  const oldAction = action.value;
  const oldTarget = form.target;
  action.value = 'preview_letter_pdf';
  form.target = '_blank';
  form.submit();
  action.value = oldAction;
  form.target = oldTarget;
}
</script>
</body></html>
