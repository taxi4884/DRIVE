function pdfText(string $text): string {
    $converted = @iconv('UTF-8', 'Windows-1252//TRANSLIT', $text);
    if ($converted === false) {
        return utf8_decode($text);
    }
    return $converted;
}

function writeComplaintLetterBody(FPDF $pdf, string $text, string $dateText, float $x = 20, float $y = 58): void {
    $lines = preg_split('/\R/u', str_replace(["\r\n", "\r"], "\n", $text)) ?: [];

    $subjectIdx = null;
    foreach ($lines as $i => $line) {
        if (mb_stripos(trim($line), 'Beschwerde zu Auftrag') === 0) {
            $subjectIdx = $i;
            break;
        }
    }

    $addr = [];
    foreach ($lines as $i => $line) {
        if ($subjectIdx !== null && $i >= $subjectIdx) break;
        if (trim($line) !== '') $addr[] = $line;
    }
    $addr = array_slice($addr, 0, 3);

    $pdf->SetFont('Arial', '', 11);
    $pdf->SetXY($x, $y);
    foreach ($addr as $line) {
        $pdf->SetX($x);
        $pdf->MultiCell(170, 5.5, pdfText($line), 0, 'L');
    }

    $pdf->SetFont('Arial', '', 11);
    $pdf->SetXY(140, 86);
    $pdf->Cell(50, 5.5, pdfText($dateText), 0, 0, 'R');

    if ($subjectIdx !== null) {
        $pdf->SetFont('Arial', 'B', 11);
        $pdf->SetXY($x, 97);
        $pdf->MultiCell(170, 5.5, pdfText(trim((string)$lines[$subjectIdx])), 0, 'L');

        $pdf->SetFont('Arial', '', 11);
        $pdf->SetXY($x, 109);
        for ($i = $subjectIdx + 1; $i < count($lines); $i++) {
            $pdf->SetX($x);
            $pdf->MultiCell(170, 5.5, pdfText((string)$lines[$i]), 0, 'L');
        }
    } else {
        $pdf->SetXY($x, 98);
        foreach ($lines as $line) {
            $pdf->SetX($x);
            $pdf->MultiCell(170, 5.5, pdfText((string)$line), 0, 'L');
        }
    }

    $pdf->SetFont('Arial', '', 11);
}

