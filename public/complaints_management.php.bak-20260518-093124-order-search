main.container.py-4 .card, main.container.py-4 .card-body { min-height: 0 !important; }
main.container.py-4 .card .card-body { padding: 1rem 1rem; }
main.container.py-4 .h5 { font-weight: 700; }
main.container.py-4 .table { --bs-table-striped-bg: #fafbfc; }
main.container.py-4 .table-responsive { height: auto !important; min-height: 0 !important; max-height: none !important; overflow-y: visible !important; }
