main.container.py-4 .card { border: 1px solid #e9ecef; border-radius: 12px; box-shadow: 0 2px 10px rgba(0,0,0,.04); }
main.container.py-4 .row.g-3.align-items-start > [class*='col-'] { align-self: flex-start; }
main.container.py-4 .col-lg-4 .card { height: auto !important; }
