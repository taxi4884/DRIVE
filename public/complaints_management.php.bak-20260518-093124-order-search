function removeInternalSentenceFromPreview(string $text): string {
    $needle = 'hiermit informieren wir Sie über das Fehlverhalten Ihres Mitarbeiters';
    $text = str_replace(["\r\n", "\r"], "\n", $text);
    $lines = explode("\n", $text);
    $filtered = [];
    foreach ($lines as $line) {
        $normalizedLine = mb_strtolower(trim($line));
        if (str_starts_with($normalizedLine, mb_strtolower($needle))) {
            continue;
        }
        $filtered[] = $line;
    }
    return trim(preg_replace("/\n{3,}/", "\n\n", implode("\n", $filtered)) ?? '');
}

