                ];
                $gw = gatewayCall($gwPayload);
                if (!$gw['ok']) {
                    $gwPayload = [
                        'SETFAHRER' => [
                            'displaynummer' => $displayNumber,
                            'display_number' => $displayNumber,
                            'aktiv_bis' => $today,
                            'AKTIV_BIS' => $today,
                        ],
                    ];
                    $gw = gatewayCall($gwPayload);
                }
                if (!$gw['ok']) {
                    throw new RuntimeException('Gateway-Call fehlgeschlagen (SETFahrer): HTTP ' . (int)$gw['http_code'] . ' ' . (string)$gw['curl_error']);
